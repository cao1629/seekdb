+def save_coverage_profiles(sdb_script, base_dir, cwd):
+    global COVERAGE_SAVE_COUNTER
+    target = os.environ.get("SEEKDB_COV_PROFRAW_DIR")
+    if not target or not Path(base_dir).is_dir():
+        return
+    subprocess.run(
+        [sys.executable, str(sdb_script), "stop", "--base-dir", str(base_dir)],
+        cwd=str(cwd),
+        check=False,
+    )
+    destination = Path(target)
+    destination.mkdir(parents=True, exist_ok=True)
+    for profile in sorted(Path(base_dir).glob("seekdb*.profraw")):
+        COVERAGE_SAVE_COUNTER += 1
+        name = "{:05d}-{}-{}".format(
+            COVERAGE_SAVE_COUNTER, int(time.time() * 1000), profile.name
+        )
+        shutil.copy2(str(profile), str(destination / name))
+        print("coverage: saved {} -> {}".format(profile, destination / name), flush=True)
+
+
 def destroy_instance(sdb_script, base_dir, cwd, check=True):
+    save_coverage_profiles(sdb_script, base_dir, cwd)

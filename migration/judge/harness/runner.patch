+
+    if not case_names:
+        raise RunnerError("case list {} names no cases".format(case_list_path))
+    duplicates = sorted(
+        name for name, count in Counter(case_names).items() if count > 1
+    )
+    if duplicates:
+        raise RunnerError(
+            "duplicate cases in case list {}: {}".format(
+                case_list_path, ", ".join(duplicates)
+            )
+        )
+    configured_names = set(case.name for case in configured_cases)
+    unknown_cases = sorted(set(case_names) - configured_names)
+    if unknown_cases:
+        raise RunnerError(
+            "case list {} names cases that are not configured: {}".format(
+                case_list_path, ", ".join(unknown_cases)
+            )
+        )
+    listed_names = set(case_names)
+    return [case for case in configured_cases if case.name in listed_names]

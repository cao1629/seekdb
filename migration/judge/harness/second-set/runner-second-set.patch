+    ]
+    not_compared = sorted(
+        set(mask["data"]) - set(entry["case"] for entry in compared)
+    )
+    statistics = {
+        "name": mask["name"],
+        "list": mask["list"],
+        "list_sha256": mask["list_sha256"],
+        "listed_cases": len(mask["data"]),

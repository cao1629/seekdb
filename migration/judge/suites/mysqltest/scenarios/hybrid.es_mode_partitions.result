drop table if exists hm_docs, hm_part;
create table hm_docs(id int, title varchar(100), body varchar(200), emb vector(3),
fulltext key ft_title(title), fulltext key ft_body(body),
vector index vidx(emb) with (distance=l2, type=hnsw, lib=vsag));
insert into hm_docs values
(1, 'database guide', 'database systems store data', '[1,0,0]'),
(2, 'search guide', 'full text search engines', '[0,1,0]'),
(3, 'vector notes', 'vector search finds neighbors', '[0,0,1]'),
(4, 'hybrid guide', 'hybrid search mixes text and vector search', '[0.5,0.5,0]'),
(5, 'storage notes', 'storage engines write data', '[0.9,0.1,0]');
#
# 1. es_mode in DBMS_HYBRID_SEARCH
#
select dbms_hybrid_search.get_sql('hm_docs', '{"query": {"match": {"body": "search"}}, "es_mode": true, "_source": ["id"]}');
dbms_hybrid_search.get_sql('hm_docs', '{"query": {"match": {"body": "search"}}, "es_mode": true, "_source": ["id"]}')
SELECT /*+ opt_param('hidden_column_visible', 'true') */`id`, score() as `_score` FROM `test`.`hm_docs` WHERE MATCH(`body`^1, 'search', 'operator=or;boost=1;type=best_fields') ORDER BY `_score` DESC, `__pk_increment` LIMIT 10
select jt.ord, jt.id, round(jt.score, 6) score
from json_table(dbms_hybrid_search.search('hm_docs', '{"query": {"match": {"body": "search"}}, "es_mode": true, "_source": ["id"]}'),
'$[*]' columns (ord for ordinality, id int path '$.id', score double path '$._score')) jt;
ord	id	score
1	4	0.375427
2	2	0.331325
3	3	0.331325
select dbms_hybrid_search.get_sql('hm_docs', '{"query": {"multi_match": {"query": "search guide", "fields": ["title^2", "body"]}}, "es_mode": "true", "_source": ["id"]}');
dbms_hybrid_search.get_sql('hm_docs', '{"query": {"multi_match": {"query": "search guide", "fields": ["title^2", "body"]}}, "es_mode": "true", "_source": ["id"]}')
SELECT /*+ opt_param('hidden_column_visible', 'true') */`id`, score() as `_score` FROM `test`.`hm_docs` WHERE MATCH(`title`^2, `body`^1, 'search guide', 'operator=or;boost=1;minimum_should_match=1;type=best_fields') ORDER BY `_score` DESC, `__pk_increment` LIMIT 10
select jt.ord, jt.id, round(jt.score, 6) score
from json_table(dbms_hybrid_search.search('hm_docs', '{"query": {"multi_match": {"query": "search guide", "fields": ["title^2", "body"]}}, "es_mode": "true", "_source": ["id"]}'),
'$[*]' columns (ord for ordinality, id int path '$.id', score double path '$._score')) jt;
ord	id	score
1	2	4.009388
2	1	0.743243
3	4	0.743243
4	3	0.331325
# the same multi_match without es_mode
select dbms_hybrid_search.get_sql('hm_docs', '{"query": {"multi_match": {"query": "search guide", "fields": ["title^2", "body"]}}, "es_mode": false, "_source": ["id"]}');
dbms_hybrid_search.get_sql('hm_docs', '{"query": {"multi_match": {"query": "search guide", "fields": ["title^2", "body"]}}, "es_mode": false, "_source": ["id"]}')
SELECT /*+ opt_param('hidden_column_visible', 'true') */`id`, (GREATEST(match(`title`) against('search' in natural language mode) * 2, match(`body`) against('search' in natural language mode)) + GREATEST(match(`title`) against('guide' in natural language mode) * 2, match(`body`) against('guide' in natural language mode))) as `_score` FROM `test`.`hm_docs` WHERE match(`title`) against('search guide' in natural language mode) OR match(`body`) against('search guide' in natural language mode) ORDER BY `_score` DESC, `__pk_increment` LIMIT 10
select jt.ord, jt.id, round(jt.score, 6) score
from json_table(dbms_hybrid_search.search('hm_docs', '{"query": {"multi_match": {"query": "search guide", "fields": ["title^2", "body"]}}, "_source": ["id"]}'),
'$[*]' columns (ord for ordinality, id int path '$.id', score double path '$._score')) jt;
ord	id	score
1	2	4.009388
2	4	1.118670
3	1	0.743243
4	3	0.331325
select dbms_hybrid_search.get_sql('hm_docs', '{"query": {"query_string": {"query": "vector search", "fields": ["body"]}}, "es_mode": true, "_source": ["id"]}');
dbms_hybrid_search.get_sql('hm_docs', '{"query": {"query_string": {"query": "vector search", "fields": ["body"]}}, "es_mode": true, "_source": ["id"]}')
SELECT /*+ opt_param('hidden_column_visible', 'true') */`id`, score() as `_score` FROM `test`.`hm_docs` WHERE MATCH(`body`^1, 'vector search', 'operator=or;boost=1;minimum_should_match=1;type=best_fields') ORDER BY `_score` DESC, `__pk_increment` LIMIT 10
select jt.ord, jt.id, round(jt.score, 6) score
from json_table(dbms_hybrid_search.search('hm_docs', '{"query": {"query_string": {"query": "vector search", "fields": ["body"]}}, "es_mode": true, "_source": ["id"]}'),
'$[*]' columns (ord for ordinality, id int path '$.id', score double path '$._score')) jt;
ord	id	score
1	3	0.777252
2	4	0.758970
3	2	0.331325
select dbms_hybrid_search.get_sql('hm_docs', '{"query": {"term": {"id": 3}}, "es_mode": true, "_source": ["id"]}');
dbms_hybrid_search.get_sql('hm_docs', '{"query": {"term": {"id": 3}}, "es_mode": true, "_source": ["id"]}')
SELECT /*+ opt_param('hidden_column_visible', 'true') */`id`, (`id` = 3) as `_score` FROM `test`.`hm_docs` WHERE `id` = 3 ORDER BY `_score` DESC, `__pk_increment` LIMIT 10
select dbms_hybrid_search.get_sql('hm_docs', '{"query": {"match": {"body": "search"}}, "knn": {"field": "emb", "k": 2, "query_vector": [0,0,1]}, "es_mode": true, "_source": ["id"]}');
dbms_hybrid_search.get_sql('hm_docs', '{"query": {"match": {"body": "search"}}, "knn": {"field": "emb", "k": 2, "query_vector": [0,0,1]}, "es_mode": true, "_source": ["id"]}')
SELECT ifnull(`_fts`.`id`, `_vs`.`id`) as `id`, (ifnull(`_fts`.`_keyword_score`, 0) + ifnull(`_vs`.`_semantic_score`, 0)) as `_score` FROM ((SELECT /*+ opt_param('hidden_column_visible', 'true') */`__pk_increment`, `id`, score() as `_keyword_score` FROM `test`.`hm_docs` WHERE MATCH(`body`^1, 'search', 'operator=or;boost=1;type=best_fields') ORDER BY `_keyword_score` DESC LIMIT 200) `_fts` full join (SELECT /*+ opt_param('hidden_column_visible', 'true') */l2_distance(`emb`, '[0, 0, 1]') as `_distance`, `__pk_increment`, `id`, round(1 / (1 + l2_distance(`emb`, '[0, 0, 1]')), 8) as `_semantic_score` FROM `test`.`hm_docs` ORDER BY `_distance` APPROXIMATE LIMIT 2) `_vs` on `_fts`.`__pk_increment` = `_vs`.`__pk_increment`) ORDER BY `_score` DESC, ifnull(`_vs`.`__pk_increment`, `_fts`.`__pk_increment`) LIMIT 10
select jt.ord, jt.id, round(jt.score, 6) score
from json_table(dbms_hybrid_search.search('hm_docs', '{"query": {"match": {"body": "search"}}, "knn": {"field": "emb", "k": 2, "query_vector": [0,0,1]}, "es_mode": true, "_source": ["id"]}'),
'$[*]' columns (ord for ordinality, id int path '$.id', score double path '$._score')) jt;
ord	id	score
1	3	1.331325
2	4	0.824916
3	2	0.331325

#
# 2. ES-style MATCH and score() in plain SQL
#
select id, score() s from hm_docs
where match(body^1, 'search', 'operator=or;boost=1;type=best_fields') order by s desc, id;
id	s
4	0.375427
2	0.331325
3	0.331325
select id, score() s from hm_docs
where match(body^2.5, 'search', 'boost=2') order by s desc, id;
id	s
4	1.877133
2	1.656627
3	1.656627
select id, score() s from hm_docs
where match(title^2, body^1, 'search guide', 'operator=or;boost=1;type=most_fields') order by s desc, id;
id	s
2	4.340713
4	1.11867
1	0.743243
3	0.331325
select id, score() s from hm_docs
where match(title^2, body^1, 'search guide', 'operator=or;boost=1;type=best_fields') order by s desc, id;
id	s
2	4.009388
1	0.743243
4	0.743243
3	0.331325
select id, score() s from hm_docs
where match(body^1, 'search vector', 'operator=or;minimum_should_match=2') order by s desc, id;
id	s
3	0.777252
4	0.75897
select id, score() s from hm_docs
where match(body^1, 'search', 'bogus=1') order by s desc, id;
id	s
4	0.375427
2	0.331325
3	0.331325
# score() must be selected as is
select id, round(score(), 6) s from hm_docs
where match(body^1, 'search', 'operator=or;boost=1;type=best_fields');

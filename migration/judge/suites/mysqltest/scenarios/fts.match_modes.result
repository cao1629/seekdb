#
# 5. two-column index
#
select id, round(match(title, body) against('databases search'), 6) s from fm_docs
where match(title, body) against('databases search') order by s desc, id;
id	s
1	1.753229
4	0.401460
7	0.371622
2	0.364238
3	0.284974
select id from fm_docs where match(title, body) against('+short' in boolean mode) order by id;
id
7
# the column list may be given in any order
select id from fm_docs where match(body, title) against('+short' in boolean mode) order by id;
id
7
#
# 6. DML
#
insert into fm_docs values (8, 'New', 'brand new search text');
update fm_docs set body = 'nothing relevant here' where id = 7;
delete from fm_docs where id = 2;
select id, round(match(body) against('search' in natural language mode), 6) s from fm_docs
where match(body) against('search' in natural language mode) order by s desc, id;
id	s
4	0.412606
8	0.333067
3	0.300485
select id from fm_docs where match(body) against('relevant') order by id;
id
7
update fm_docs set body = NULL where id = 8;
select id from fm_docs where match(body) against('brand') order by id;
id
#
# 7. document count fixed at plan time
#
create table fm_pc(id int primary key, body text, fulltext key ftb(body));
insert into fm_pc values (1, 'alpha beta'), (2, 'alpha gamma'), (3, 'delta epsilon'), (4, 'zeta eta');
select id, round(match(body) against('alpha'), 6) s from fm_pc where match(body) against('alpha') order by s desc, id;
id	s
1	0.371622
2	0.371622
insert into fm_pc values (5, 'theta iota'), (6, 'kappa lambda'), (7, 'mu nu'), (8, 'xi omicron'), (9, 'pi rho'), (10, 'sigma tau');
# identical statement text: old document count (4)
select id, round(match(body) against('alpha'), 6) s from fm_pc where match(body) against('alpha') order by s desc, id;
id	s
1	0.371622
2	0.371622
# new statement text: current document count (10)
select id, round(match(body) against('alpha'), 6) s from fm_pc where match(body) against('alpha') order by s desc, id limit 5;
id	s
1	1.819126
2	1.819126
#
# cleanup
#
drop table fm_docs, fm_pc;

#
# 6. quantized HNSW variants
#
create table hn_sq(id int primary key, v vector(4),
vector index vidx(v) with (distance=l2, type=hnsw_sq, lib=vsag));
insert into hn_sq select id, v from hn_ip;
create table hn_bq(id int primary key, v vector(4),
vector index vidx(v) with (distance=l2, type=hnsw_bq, lib=vsag));
insert into hn_bq select id, v from hn_ip;
show create table hn_sq;
Table	Create Table
hn_sq	CREATE TABLE `hn_sq` (
  `id` int(11) NOT NULL,
  `v` VECTOR(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vidx` (`v`) WITH (DISTANCE=L2, TYPE=HNSW_SQ, LIB=VSAG, M=16, EF_CONSTRUCTION=200, EF_SEARCH=64) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
show create table hn_bq;
Table	Create Table
hn_bq	CREATE TABLE `hn_bq` (
  `id` int(11) NOT NULL,
  `v` VECTOR(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vidx` (`v`) WITH (DISTANCE=L2, TYPE=HNSW_BQ, LIB=VSAG, M=16, EF_CONSTRUCTION=200, EF_SEARCH=64, REFINE_TYPE=SQ8, BQ_USE_FHT=TRUE) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0

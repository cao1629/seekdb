14	4.123106
3	6.244998
7	7.280110
11	9.848858
13	11.618950
select id, round(l2_distance(v, '[2,12,8,1]'), 6) d from hn_l2
order by l2_distance(v, '[2,12,8,1]') limit 5;
id	d
14	4.123106
3	6.244998

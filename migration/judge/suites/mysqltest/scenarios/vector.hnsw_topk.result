#
# 7. errors
#
select id from hn_l2 order by l2_distance(v, '[1,1,1,1]') approx;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your OceanBase version for the right syntax to use near 'approx' at line 1
select id from hn_l2 order by l2_distance(v, '[1,1,1,1]'), id approx limit 3;
ERROR 0A000: Multi order by item when using vector index is not supported
select id from hn_l2 order by l2_distance(v, '[1,1,1,1]') approx limit 3 for update;
ERROR 0A000: FOR UPDATE with APPROXIMATE vector search is not supported
#
# cleanup
#
drop table hn_l2, hn_ip, hn_cos, hn_sq, hn_bq;

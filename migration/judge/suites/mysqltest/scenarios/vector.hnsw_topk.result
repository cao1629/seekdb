select count(*) from hn_l2;
count(*)
17
#
# 4. inner_product index
#
create table hn_ip(id int primary key, v vector(4),
vector index vidx(v) with (distance=inner_product, type=hnsw, lib=vsag));
insert into hn_ip select id, v from hn_l2 where id <= 16 and id <> 14;
insert into hn_ip values (14, '[4,15,6,1]');
show create table hn_ip;
Table	Create Table
hn_ip	CREATE TABLE `hn_ip` (
  `id` int(11) NOT NULL,
  `v` VECTOR(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vidx` (`v`) WITH (DISTANCE=INNER_PRODUCT, TYPE=HNSW, LIB=VSAG, M=16, EF_CONSTRUCTION=200, EF_SEARCH=64) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
select id, round(negative_inner_product(v, '[2,12,8,1]'), 6) d from hn_ip
order by negative_inner_product(v, '[2,12,8,1]') approx limit 5;

drop table if exists hn_l2, hn_ip, hn_cos, hn_sq, hn_bq;
create table hn_l2(id int primary key, cat char(1), v vector(4),
vector index vidx(v) with (distance=l2, type=hnsw, lib=vsag));
show create table hn_l2;
Table	Create Table
hn_l2	CREATE TABLE `hn_l2` (
  `id` int(11) NOT NULL,
  `cat` char(1) DEFAULT NULL,
  `v` VECTOR(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vidx` (`v`) WITH (DISTANCE=L2, TYPE=HNSW, LIB=VSAG, M=16, EF_CONSTRUCTION=200, EF_SEARCH=64) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
insert into hn_l2 values
(1, 'a', '[0,0,0,1]'), (2, 'b', '[12,1,0,0]'), (3, 'a', '[1,13,2,0]'), (4, 'b', '[0,2,15,1]'),
(5, 'a', '[3,0,1,17]'), (6, 'b', '[11,12,0,2]'), (7, 'a', '[0,9,14,3]'), (8, 'b', '[2,1,11,16]'),
(9, 'a', '[13,3,1,10]'), (10, 'b', '[9,11,12,13]'), (11, 'a', '[5,6,4,7]'), (12, 'b', '[21,19,22,18]'),
(13, 'a', '[7,2,9,4]'), (14, 'b', '[4,15,6,1]'), (15, 'a', '[16,8,3,5]'), (16, 'b', '[6,4,18,11]');
#
# 1. l2: approximate = exact
#
select id, round(l2_distance(v, '[1,1,1,1]'), 6) d from hn_l2
order by l2_distance(v, '[1,1,1,1]') approximate limit 5;
id	d
1	1.732051
11	9.273618
13	10.488088
2	11.090537
3	12.083046
select id, round(l2_distance(v, '[1,1,1,1]'), 6) d from hn_l2
order by l2_distance(v, '[1,1,1,1]') limit 5;
id	d
1	1.732051
11	9.273618
13	10.488088
2	11.090537
3	12.083046
select id, round(l2_distance(v, '[2,12,8,1]'), 6) d from hn_l2
order by l2_distance(v, '[2,12,8,1]') approx limit 5;

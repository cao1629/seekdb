select id, v from hn_l2 order by l2_distance(v, '[2,12,8,1]') approx limit 2 offset 1;
id	v
3	[1,13,2,0]
7	[0,9,14,3]
# cosine_distance on the l2 index: still the exact cosine answer
select id, round(cosine_distance(v, '[1,1,1,1]'), 6) d from hn_l2
order by cosine_distance(v, '[1,1,1,1]') approx limit 3;
id	d
12	0.003110
10	0.008532
11	0.020042
select id, round(cosine_distance(v, '[1,1,1,1]'), 6) d from hn_l2
order by cosine_distance(v, '[1,1,1,1]') limit 3;
id	d
12	0.003110
10	0.008532
11	0.020042

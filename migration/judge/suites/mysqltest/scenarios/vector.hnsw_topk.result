11	9.273618
13	10.488088
2	11.090537
3	12.083046
4	14.071247
6	14.933185
9	15.132746
7	15.427249
5	16.155494
15	17.146428
8	18.055470
16	20.566964
10	20.712315
12	38.131352
17	198.000000
select id, round(l2_distance(v, '[1,1,1,1]'), 6) d from hn_l2
order by l2_distance(v, '[1,1,1,1]') limit 3;

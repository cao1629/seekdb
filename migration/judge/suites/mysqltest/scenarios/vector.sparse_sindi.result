drop table if exists sp_val, sp_idx, sp_err;
#
# 1. literals and functions
#
create table sp_val(id int primary key, sv sparsevector);
insert into sp_val values
(1, '{1:1, 2:2}'), (2, '{3:3}'), (3, '{}'), (4, '{1:0.5, 3:0.5, 5:5}'), (5, NULL),
(6, '{ 2 : 1.0 , 1:1}'), (7, '{10:0.25, 3:1.5, 1:2}'), (8, '{1:1, 1:2}');
select * from sp_val order by id;
id	sv
1	{1:1,2:2}
2	{3:3}
3	{}
4	{1:0.5,3:0.5,5:5}
5	NULL
6	{1:1,2:1}
7	{1:2,3:1.5,10:0.25}
8	{1:2}
select id, inner_product(sv, '{1:1, 3:1}') ip, negative_inner_product(sv, '{1:1, 3:1}') nip,
vector_dims(sv) dims from sp_val order by id;
id	ip	nip	dims
1	1	-1	2
2	3	-3	1
3	0	0	0
4	1	-1	3
5	NULL	NULL	NULL
6	1	-1	2
7	3.5	-3.5	3
8	2	-2	1
insert into sp_val values (9, '{a:1}');
ERROR HY000: Incorrect arguments to sparse vector dimension, must be an unsigned integer
insert into sp_val values (10, '[1,2]');
ERROR HY000: Incorrect arguments to sparse vector, expect '{'
insert into sp_val values (11, '{-1:1}');
ERROR HY000: Incorrect arguments to sparse vector dimension, must be an unsigned integer
insert into sp_val values (12, '{1:abc}');
ERROR HY000: Incorrect arguments to sparse vector value, must be a float
select l2_distance(sv, '{1:1}') from sp_val where id = 1;
ERROR 22000: Invalid data type for the operation
select cosine_distance(sv, '{1:1}') from sp_val where id = 1;
ERROR 22000: Invalid data type for the operation
select vector_norm(sv) from sp_val where id = 1;
ERROR HY000: Invalid argument
delete from sp_val;
select l2_distance(sv, '{1:1}') from sp_val;
ERROR 22000: Invalid data type for the operation
#
# 2. SINDI index DDL
#
create table sp_idx(id int primary key, cat char(1), sv sparsevector,
vector index sidx(sv) with (distance=inner_product, type=sindi, lib=vsag));
show create table sp_idx;
Table	Create Table
sp_idx	CREATE TABLE `sp_idx` (
  `id` int(11) NOT NULL,
  `cat` char(1) DEFAULT NULL,
  `sv` SPARSEVECTOR DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `sidx` (`sv`) WITH (DISTANCE=INNER_PRODUCT, TYPE=SINDI, LIB=VSAG) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
create table sp_err(id int primary key, sv sparsevector,
vector index sidx(sv) with (distance=l2, type=sindi, lib=vsag));
ERROR 0A000: this type of sparse vector index distance algorithm is not supported
create table sp_err(id int primary key, sv sparsevector,
vector index sidx(sv) with (distance=inner_product, type=hnsw, lib=vsag));
ERROR 0A000: the vector index params of distance or type not set is not supported
create table sp_err(id int primary key, sv vector(3),
vector index sidx(sv) with (distance=inner_product, type=sindi, lib=vsag));
ERROR 0A000: the vector index params of distance or type not set is not supported
#
# 3. approximate top-k against exact top-k
#
insert into sp_idx values
(1, 'a', '{1:0.9, 2:0.1}'), (2, 'b', '{2:0.8, 3:0.3}'), (3, 'a', '{3:0.7, 4:0.6}'),
(4, 'b', '{1:0.2, 4:0.9}'), (5, 'a', '{5:1.0}'), (6, 'b', '{1:0.5, 2:0.5, 3:0.5}'),
(7, 'a', '{2:0.05, 6:0.9}'), (8, 'b', NULL);
select id, round(negative_inner_product(sv, '{1:1, 2:0.5}'), 6) s from sp_idx
order by negative_inner_product(sv, '{1:1, 2:0.5}') approx limit 4;
id	s
1	-0.950000
6	-0.750000
2	-0.400000
4	-0.200000
select id, round(negative_inner_product(sv, '{1:1, 2:0.5}'), 6) s from sp_idx
order by negative_inner_product(sv, '{1:1, 2:0.5}'), id limit 5;
id	s
8	NULL
1	-0.950000
6	-0.750000
2	-0.400000
4	-0.200000
select id, round(negative_inner_product(sv, '{1:1, 2:0.5}'), 6) s from sp_idx
order by negative_inner_product(sv, '{1:1, 2:0.5}') approx limit 10;
id	s
1	-0.950000
6	-0.750000
2	-0.400000
4	-0.200000
7	-0.025000
select id, round(negative_inner_product(sv, '{3:1, 4:1}'), 6) s from sp_idx
order by negative_inner_product(sv, '{3:1, 4:1}') approximate limit 3;
id	s
3	-1.300000
4	-0.900000
6	-0.500000
# no shared dimension, empty query
select id from sp_idx order by negative_inner_product(sv, '{9:1}') approx limit 3;
id
select id, round(negative_inner_product(sv, '{9:1}'), 6) s from sp_idx
order by negative_inner_product(sv, '{9:1}'), id limit 3;
id	s
8	NULL
1	0.000000
2	0.000000
select id from sp_idx order by negative_inner_product(sv, '{}') approx limit 3;
id
# filtered
select id, cat, round(negative_inner_product(sv, '{3:1, 4:1}'), 6) s from sp_idx where cat = 'b'
  order by negative_inner_product(sv, '{3:1, 4:1}') approx limit 3;
id	cat	s
4	b	-0.900000
6	b	-0.500000
2	b	-0.300000
select id, round(negative_inner_product(sv, '{3:1, 4:1}'), 6) s from sp_idx where id > 2
order by negative_inner_product(sv, '{3:1, 4:1}') approx limit 3;
id	s
3	-1.300000
4	-0.900000
6	-0.500000
# DML
insert into sp_idx values (9, 'a', '{1:5}');
update sp_idx set sv = '{7:1}' where id = 1;
delete from sp_idx where id = 6;
select id, round(negative_inner_product(sv, '{1:1, 2:0.5}'), 6) s from sp_idx
order by negative_inner_product(sv, '{1:1, 2:0.5}') approx limit 4;
id	s
9	-5.000000
2	-0.400000
4	-0.200000
7	-0.025000
select id, round(negative_inner_product(sv, '{7:2}'), 6) s from sp_idx
order by negative_inner_product(sv, '{7:2}') approx limit 4;
id	s
1	-2.000000
#
# cleanup
#
drop table sp_val, sp_idx;

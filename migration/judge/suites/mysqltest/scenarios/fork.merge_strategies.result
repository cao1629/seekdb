#
# 6. FAIL without conflicts applies the inserts
#
create table mg_ins_cur(id int primary key, v varchar(20));
insert into mg_ins_cur values (1, 'a'), (2, 'b');
fork table mg_ins_cur to mg_ins_inc;
insert into mg_ins_inc values (3, 'c'), (4, 'd');
delete from mg_ins_inc where id = 1;
insert into mg_ins_cur values (5, 'e');
merge table mg_ins_inc into mg_ins_cur;
affected rows: 2
select * from mg_ins_cur order by id;
id	v
1	a
2	b
3	c
4	d
5	e
# MERGE of a table into itself
merge table mg_ins_cur into mg_ins_cur strategy theirs;
affected rows: 0
#
# 7. collation decides what a conflict is
#
create table mg_bin_cur(id int primary key, v varchar(20) collate utf8mb4_bin, w varchar(20));
insert into mg_bin_cur values (1, 'ten', 'ten'), (2, 'x', 'x');
fork table mg_bin_cur to mg_bin_inc;
update mg_bin_inc set v = 'TEN' where id = 1;
update mg_bin_inc set w = 'X' where id = 2;
diff table mg_bin_cur against mg_bin_inc;
__table	__flag	id	v	w
test.mg_bin_cur	INSERT	1	ten	ten
test.mg_bin_inc	INSERT	1	TEN	ten
merge table mg_bin_inc into mg_bin_cur;
ERROR HY000: MERGE TABLE: 1 conflict(s) detected. Use THEIRS or OURS strategy to resolve. FAIL strategy is not allowed
merge table mg_bin_inc into mg_bin_cur strategy theirs;
affected rows: 1
select * from mg_bin_cur order by id;
id	v	w
1	TEN	ten
2	x	x
select * from mg_bin_inc order by id;
id	v	w
1	TEN	ten
2	x	X
#
# 8. generated columns are compared but recomputed
#
create table mg_gen_cur(a int, b int, v int,
g int generated always as (v * 10) virtual,
s int as (v + 1) stored,
primary key (a, b));
insert into mg_gen_cur(a, b, v) values (1, 1, 1), (1, 2, 2), (2, 1, 3);
fork table mg_gen_cur to mg_gen_inc;
update mg_gen_inc set v = 20 where a = 1 and b = 2;
insert into mg_gen_inc(a, b, v) values (2, 2, 4);
delete from mg_gen_inc where a = 2 and b = 1;
diff table mg_gen_cur against mg_gen_inc;
__table	__flag	a	b	v	g	s
test.mg_gen_cur	INSERT	1	2	2	20	3
test.mg_gen_inc	INSERT	1	2	20	200	21
test.mg_gen_cur	INSERT	2	1	3	30	4
test.mg_gen_inc	INSERT	2	2	4	40	5
merge table mg_gen_inc into mg_gen_cur;
ERROR HY000: MERGE TABLE: 1 conflict(s) detected. Use THEIRS or OURS strategy to resolve. FAIL strategy is not allowed
merge table mg_gen_inc into mg_gen_cur strategy theirs;
affected rows: 2
select * from mg_gen_cur order by a, b;
a	b	v	g	s
1	1	1	10	2
1	2	20	200	21
2	1	3	30	4
2	2	4	40	5

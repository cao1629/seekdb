12	twelve-cur	12
13	thirteen-inc	13
# left over: only rows that exist only in current (5, 12)
diff table mg_theirs against mg_inc;
__table	__flag	id	v	n
test.mg_theirs	INSERT	5	five	5
test.mg_theirs	INSERT	12	twelve-cur	12
# nothing conflicts any more, so FAIL now succeeds and changes nothing
merge table mg_inc into mg_theirs strategy fail;
affected rows: 0
merge table mg_inc into mg_theirs;
affected rows: 0

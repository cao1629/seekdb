#
# 3. THEIRS: 2 inserts (6, 11) + 5 updates (1, 2, 3, 9, 13)
#
merge table mg_inc into mg_theirs strategy theirs;
affected rows: 7
select row_count();
row_count()
0
select * from mg_theirs order by id;

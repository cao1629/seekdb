create database fdb_empty;
fork database fdb_empty to fdb_empty2;
show databases like 'fdb_empty%';
Database (fdb_empty%)
fdb_empty
fdb_empty2
show tables from fdb_empty2;
Tables_in_fdb_empty2
create database fdb_case;
create table fdb_case.t(id int primary key);
fork database FDB_CASE to FDB_Case2;
show databases like 'fdb_case%';
Database (fdb_case%)
fdb_case
fdb_case2

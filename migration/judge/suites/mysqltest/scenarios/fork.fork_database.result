#
# 3. the two databases are independent
#
insert into fdb_dst.p(name) values ('c');
insert into fdb_src.p(name) values ('d');
select * from fdb_src.p order by id;
id	name
1	a
2	b
3	d
select * from fdb_dst.p order by id;
id	name
1	a
2	b
3	c
insert into fdb_dst.c values (3, 99, 1);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails
insert into fdb_dst.p(name) values ('a');
ERROR 23000: Duplicate entry 'a' for key 'uk_name'
insert into fdb_dst.c values (3, 1, -1);
ERROR HY000: check constraint violated
delete from fdb_dst.tree where id = 1;
ERROR 23000: Cannot delete or update a parent row: a foreign key constraint fails
# the cross-database foreign key was not copied
insert into fdb_dst.x values (2, 99);
insert into fdb_src.x values (2, 99);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails
delete from fdb_src.c where id = 1;
update fdb_dst.c set qty = 50 where id = 2;
update fdb_dst.g set v = 25 where id = 2;
select * from fdb_src.c order by id;
id	pid	qty
2	2	6
select * from fdb_dst.c order by id;
id	pid	qty
1	1	5
2	2	50
select * from fdb_dst.g order by id;
id	v	w
1	10	20
2	25	50
3	30	60
diff table fdb_src.c against fdb_dst.c;
__table	__flag	id	pid	qty
fdb_dst.c	INSERT	1	1	5
fdb_dst.c	INSERT	2	2	50
fdb_src.c	INSERT	2	2	6
diff table fdb_src.g against fdb_dst.g;
__table	__flag	id	v	w
fdb_dst.g	INSERT	2	25	50
fdb_src.g	INSERT	2	20	40

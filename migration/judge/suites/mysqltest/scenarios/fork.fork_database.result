drop database if exists fdb_src;
drop database if exists fdb_dst;
drop database if exists fdb_other;
drop database if exists fdb_empty;
drop database if exists fdb_empty2;
drop database if exists fdb_routine;
drop database if exists fdb_routine2;
drop database if exists fdb_func;
drop database if exists fdb_func2;
drop database if exists fdb_trigger;
drop database if exists fdb_trigger2;
drop database if exists fdb_spatial;
drop database if exists fdb_spatial2;
drop database if exists fdb_case;
#
# 1. source database
#
create database fdb_other;
create table fdb_other.ref(id int primary key);
insert into fdb_other.ref values (1), (2);
create database fdb_src;
create table fdb_src.p(id int primary key auto_increment, name varchar(20) not null,
unique key uk_name(name));
create table fdb_src.c(id int primary key, pid int, qty int default 7,
constraint fk_c_p foreign key (pid) references fdb_src.p(id),
key k_qty(qty),
constraint ck_qty check (qty > 0));
create table fdb_src.x(id int primary key, rid int,
constraint fk_x_ref foreign key (rid) references fdb_other.ref(id));
create table fdb_src.tree(id int primary key, parent int,
constraint fk_tree foreign key (parent) references fdb_src.tree(id));
create table fdb_src.g(id int primary key, v int, w int as (v * 2) stored)
partition by hash(id) partitions 2;
insert into fdb_src.p(name) values ('a'), ('b');
insert into fdb_src.c values (1, 1, 5), (2, 2, 6);
insert into fdb_src.x values (1, 1);
insert into fdb_src.tree values (1, null), (2, 1);
insert into fdb_src.g(id, v) values (1, 10), (2, 20), (3, 30);
create view fdb_src.v as select p.name, c.qty from fdb_src.p join fdb_src.c on p.id = c.pid;
#
# 2. fork and inspect the copy
#
fork database fdb_src to fdb_dst;
show tables from fdb_src;
Tables_in_fdb_src
c
g
p
tree
v
x
show tables from fdb_dst;
Tables_in_fdb_dst
c
g
p
tree
x
show create table fdb_src.p;

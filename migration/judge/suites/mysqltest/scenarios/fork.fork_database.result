p	CREATE TABLE `p` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(20) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_name` (`name`) BLOCK_SIZE 16384 LOCAL
) ORGANIZATION INDEX AUTO_INCREMENT = 3 DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
show create table fdb_dst.p;
Table	Create Table
p	CREATE TABLE `p` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(20) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_name` (`name`) BLOCK_SIZE 16384 LOCAL
) ORGANIZATION INDEX AUTO_INCREMENT = 3 DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
show create table fdb_dst.c;
Table	Create Table
c	CREATE TABLE `c` (
  `id` int(11) NOT NULL,
  `pid` int(11) DEFAULT NULL,
  `qty` int(11) DEFAULT '7',
  PRIMARY KEY (`id`),
  CONSTRAINT `fk_c_p` FOREIGN KEY (`pid`) REFERENCES `fdb_dst`.`p`(`id`) ON UPDATE RESTRICT ON DELETE RESTRICT ,
  KEY `k_qty` (`qty`) BLOCK_SIZE 16384 LOCAL,
  CONSTRAINT `ck_qty` CHECK ((`qty` > 0))
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
show create table fdb_dst.x;
Table	Create Table
x	CREATE TABLE `x` (
  `id` int(11) NOT NULL,
  `rid` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
show create table fdb_dst.tree;
Table	Create Table
tree	CREATE TABLE `tree` (
  `id` int(11) NOT NULL,
  `parent` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`),
  CONSTRAINT `fk_tree` FOREIGN KEY (`parent`) REFERENCES `fdb_dst`.`tree`(`id`) ON UPDATE RESTRICT ON DELETE RESTRICT 
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
show create table fdb_dst.g;
Table	Create Table
g	CREATE TABLE `g` (
  `id` int(11) NOT NULL,
  `v` int(11) DEFAULT NULL,
  `w` int(11) GENERATED ALWAYS AS ((`v` * 2)) STORED,
  PRIMARY KEY (`id`)
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
 partition by hash(id)

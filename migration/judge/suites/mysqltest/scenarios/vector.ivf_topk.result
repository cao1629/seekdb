#
# 4. IVF_SQ8 built on existing rows: quantized ranking
#
create table ivf_sq8(id int primary key, v vector(4));
insert into ivf_sq8 select id, v from ivf_src;
create vector index vidx on ivf_sq8(v) with (distance=l2, type=ivf_sq8, nlist=3);
show create table ivf_sq8;
Table	Create Table
ivf_sq8	CREATE TABLE `ivf_sq8` (
  `id` int(11) NOT NULL,
  `v` VECTOR(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vidx` (`v`) WITH (DISTANCE=L2, TYPE=IVF_SQ8, NLIST=3, LIB=OB, SAMPLE_PER_NLIST=256) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
select id, round(l2_distance(v, '[2,12,8,1]'), 6) d from ivf_sq8
order by l2_distance(v, '[2,12,8,1]') approx limit 6;
id	d
14	4.123106
3	6.244998
7	7.280110
11	9.848858
6	12.083046
13	11.618950
select id, round(l2_distance(v, '[2,12,8,1]'), 6) d from ivf_sq8
order by l2_distance(v, '[2,12,8,1]') limit 6;
id	d

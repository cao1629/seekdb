drop database if exists hualong;
create database hualong;
use hualong;
create table using_hash_t1 (c1 int, c2 int, primary key using hash (c1));
create table using_btree_t1 (c1 int, c2 int, primary key using btree (c1));
select table_name, index_name, index_type from information_schema.statistics where table_schema = 'hualong' and table_name = 'using_hash_t1';
table_name	index_name	index_type
using_hash_t1	PRIMARY	HASH
select table_name, index_name, index_type from information_schema.statistics where table_schema = 'hualong' and table_name = 'using_btree_t1';
table_name	index_name	index_type
using_btree_t1	PRIMARY	BTREE
select index_name, table_name as data_table_name, index_type
from information_schema.statistics
where index_type = 'HASH' and index_name != 'PRIMARY'
  order by 1;
index_name	data_table_name	index_type
drop database hualong;

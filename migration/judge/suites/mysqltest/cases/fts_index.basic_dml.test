DROP TABLE IF EXISTS basic_dml_t2;
--enable_warnings

CREATE TABLE basic_dml_t1 (a int PRIMARY KEY, b varchar(10000), FULLTEXT INDEX(b));

CREATE TABLE basic_dml_t2 (a int, b varchar(10000));


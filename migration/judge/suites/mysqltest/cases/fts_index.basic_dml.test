# [judge] Every change is marked "[judge]"; see migration/judge/suites/mysqltest/rewrites/b5-fts.tsv.
# owner: yunshan.tys
# owner group: storage
# description test basic dml for fulltext search

connect(sys_conn, $OBMYSQL_MS0, root@sys,,oceanbase, $OBMYSQL_PORT);
connection sys_conn;

# [judge] removed: alter system set _enable_add_fulltext_index_to_existing_table = true; (hidden parameter;
# [judge] it only gates building multivalue indexes afterward; the ALTER TABLE ... ADD FULLTEXT INDEX below
# [judge] do not need it).

--disable_warnings
drop database if exists fts_basic_dml;
--enable_warnings

create database fts_basic_dml;

use fts_basic_dml;

# [judge] removed: let $database_id from oceanbase.__all_database (Tier B).

--disable_warnings
DROP TABLE IF EXISTS fts_basic_dml_articles;
--enable_warnings

--result_format 3

--echo ######## Create Table With Auto Increment Column #########
--echo ======================== create ==========================
CREATE TABLE fts_basic_dml_articles (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(200),
    content TEXT,
    FULLTEXT INDEX ctx(title, content)
);

# [judge] removed: set _show_ddl_in_compat_mode = 1; (hidden session variable). The SHOW CREATE TABLE below
# [judge] is kept and now shows the default rendering; the compat-mode rendering is no longer covered.
SHOW CREATE TABLE fts_basic_dml_articles;

# [judge] removed: set _show_ddl_in_compat_mode = 0; (hidden session variable, restores the default).
SHOW CREATE TABLE fts_basic_dml_articles;

SHOW INDEX FROM fts_basic_dml_articles;

# [judge] removed: lets reading table ids and hidden FTS column names from oceanbase.__all_table and
# [judge] oceanbase.__all_column (Tier B).

--echo ======================== insert ==========================

--enable_query_log

INSERT INTO fts_basic_dml_articles (title, content) VALUES
('OceanBase Tutorial', 'This is a tutorial about Oceanbase Fulltext.'),
('Fulltext Index', 'Fulltext index can be very useful.'),
('OceanBase Test Case', 'Writing test cases helps ensure quality.');

select * from fts_basic_dml_articles order by id;

set ob_enable_index_direct_select = 'ON';

# [judge] was (Tier B): evals reading the hidden aux tables of the fulltext index directly (rowkey<->doc_id
# [judge] maps, and word/doc_id/word_count/doc_length rows of the inverted and doc-word tables), framed by
# [judge] query-log toggles. The rowkey<->doc_id maps are internal and are dropped. The word->row content is
# [judge] asserted publicly by MATCH ... AGAINST probes: per probe word the matching rows with relevance
# [judge] rounded to 6 decimals (BM25 over word_count, doc_length, the number of rows containing the word and
# [judge] the total row count), plus one probe with every indexed word of the corpus. Each probe step uses
# [judge] its own column alias on purpose: MATCH constants are parameterized, so a reused statement text is
# [judge] served from the plan cache with the total row count estimated when it was compiled (measured on the
# [judge] original: 3 instead of 5 after the second INSERT); with a fresh plan the count is the current one
# [judge] after INSERT, UPDATE and DELETE alike. The same probes replace every later dump of this kind.
select id, round(match(title, content) against('oceanbase'), 6) as s1_ins1 from fts_basic_dml_articles where match(title, content) against('oceanbase') order by id;
select id, round(match(title, content) against('fulltext'), 6) as s1_ins1 from fts_basic_dml_articles where match(title, content) against('fulltext') order by id;
select id, round(match(title, content) against('index'), 6) as s1_ins1 from fts_basic_dml_articles where match(title, content) against('index') order by id;
select id, round(match(title, content) against('indexing'), 6) as s1_ins1 from fts_basic_dml_articles where match(title, content) against('indexing') order by id;
select id, round(match(title, content) against('tutorial'), 6) as s1_ins1 from fts_basic_dml_articles where match(title, content) against('tutorial') order by id;
select id, round(match(title, content) against('database'), 6) as s1_ins1 from fts_basic_dml_articles where match(title, content) against('database') order by id;
select id, round(match(title, content) against('can case cases database databases ensure fulltext guide helps index indexing oceanbase optimization optimizing quality query test tutorial use useful using very writing'), 6) as s1_ins1 from fts_basic_dml_articles where match(title, content) against('can case cases database databases ensure fulltext guide helps index indexing oceanbase optimization optimizing quality query test tutorial use useful using very writing') order by id;


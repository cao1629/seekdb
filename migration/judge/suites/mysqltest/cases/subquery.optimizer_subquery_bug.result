insert/**/ into t1 values (1, 1), (2, 2);
insert/**/ into t2 values (1, 1), (2, 2);
select * from t1 where not exists (select /*+no_unnest*/ 1 from (select 1 + t1.c1 as c1, t2.c2 as s2 from t2) v where c1 = s2 and c1 + 1 <= s2);
+------+------+
| c1   | c2   |

--result_format 4

##show relation system table
# [judge] removed (Tier B, column layout of internal tables; no public equivalent):
# [judge]   desc oceanbase.__all_optstat_global_prefs;
# [judge]   desc oceanbase.__all_optstat_user_prefs;

##test query global prefs
# [judge] was: select SNAME, SVAL1, SPARE4 from oceanbase.__all_optstat_global_prefs;  (internal table, Tier B)
# [judge] Same fact through the public DBMS_STATS API: the value of every global preference that table holds.
# [judge] GET_PREFS returns the stored SPARE4 string; STATS_RETENTION (stored in SVAL1) comes from
# [judge] GET_STATS_HISTORY_RETENTION. The same replacement is used for the two later copies of this query.
select 'APPROXIMATE_NDV' as SNAME, dbms_stats.get_prefs('APPROXIMATE_NDV') as PVALUE from dual
union all select 'ASYNC_GATHER_FULL_TABLE_SIZE', dbms_stats.get_prefs('ASYNC_GATHER_FULL_TABLE_SIZE') from dual
union all select 'ASYNC_GATHER_SAMPLE_SIZE', dbms_stats.get_prefs('ASYNC_GATHER_SAMPLE_SIZE') from dual
union all select 'ASYNC_GATHER_STALE_RATIO', dbms_stats.get_prefs('ASYNC_GATHER_STALE_RATIO') from dual
union all select 'ASYNC_STALE_MAX_TABLE_SIZE', dbms_stats.get_prefs('ASYNC_STALE_MAX_TABLE_SIZE') from dual
union all select 'AUTO_SAMPLE_ROW_COUNT', dbms_stats.get_prefs('AUTO_SAMPLE_ROW_COUNT') from dual
union all select 'BLOCK_SAMPLE', dbms_stats.get_prefs('BLOCK_SAMPLE') from dual
union all select 'CASCADE', dbms_stats.get_prefs('CASCADE') from dual
union all select 'DEGREE', dbms_stats.get_prefs('DEGREE') from dual
union all select 'ESTIMATE_BLOCK', dbms_stats.get_prefs('ESTIMATE_BLOCK') from dual
union all select 'ESTIMATE_PERCENT', dbms_stats.get_prefs('ESTIMATE_PERCENT') from dual
union all select 'GATHER_STATS_BATCH_SIZE', dbms_stats.get_prefs('GATHER_STATS_BATCH_SIZE') from dual
union all select 'GRANULARITY', dbms_stats.get_prefs('GRANULARITY') from dual
union all select 'HIST_BLOCK_SAMPLE', dbms_stats.get_prefs('HIST_BLOCK_SAMPLE') from dual
union all select 'HIST_EST_PERCENT', dbms_stats.get_prefs('HIST_EST_PERCENT') from dual
union all select 'INCREMENTAL', dbms_stats.get_prefs('INCREMENTAL') from dual
union all select 'INCREMENTAL_LEVEL', dbms_stats.get_prefs('INCREMENTAL_LEVEL') from dual
union all select 'METHOD_OPT', dbms_stats.get_prefs('METHOD_OPT') from dual
union all select 'NO_INVALIDATE', dbms_stats.get_prefs('NO_INVALIDATE') from dual
union all select 'ONLINE_ESTIMATE_PERCENT', dbms_stats.get_prefs('ONLINE_ESTIMATE_PERCENT') from dual
union all select 'OPTIONS', dbms_stats.get_prefs('OPTIONS') from dual
union all select 'STALE_PERCENT', dbms_stats.get_prefs('STALE_PERCENT') from dual
union all select 'STATS_RETENTION', cast(dbms_stats.get_stats_history_retention() as char) from dual
order by 1;

##test set prefs
call dbms_stats.set_global_prefs('APPROXIMATE_NDV', 'FALSE');
select dbms_stats.get_prefs('APPROXIMATE_NDV') from dual;

call dbms_stats.set_param('CASCADE', 'true');
select dbms_stats.get_param('CASCADE') from dual;

call dbms_stats.set_global_prefs('degree', '2');
select dbms_stats.get_prefs('DEGREE') from dual;

call dbms_stats.set_param('ESTIMATE_PERCENT', '50');
select dbms_stats.get_param('ESTIMATE_PERCENT') from dual;

call dbms_stats.set_global_prefs('GRANULARITY', 'ALL');
select dbms_stats.get_param('GRANULARITY') from dual;

call dbms_stats.set_param('INCREMENTAL', 'TRUE');
select dbms_stats.get_prefs('INCREMENTAL') from dual;

call dbms_stats.set_param('INCREMENTAL_LEVEL', NULL);
select dbms_stats.get_prefs('INCREMENTAL_LEVEL') from dual;

call dbms_stats.set_global_prefs('method_OPT', 'FOR ALL COLUMNS SIZE 5');
select dbms_stats.get_prefs('METHOD_OPT') from dual;

call dbms_stats.set_global_prefs('method_OPT', NULL);
select dbms_stats.get_prefs('METHOD_OPT') from dual;

call dbms_stats.set_param('NO_INVALIDATE', 'TRUE');
select dbms_stats.get_prefs('NO_INVALIDATE') from dual;

call dbms_stats.set_global_prefs('OPTIONS', 'GATHER AUTO');
select dbms_stats.get_prefs('OPTIONS') from dual;

call dbms_stats.set_global_prefs('STALE_PERCENT', '50');
select dbms_stats.get_prefs('STALE_PERCENT') from dual;

call dbms_stats.set_global_prefs('STALE_PERCENT', NULL);
select dbms_stats.get_prefs('STALE_PERCENT') from dual;

select dbms_stats.get_param('ESTIMATE_BLOCK') from dual;
call dbms_stats.set_global_prefs('ESTIMATE_BLOCK', 'FALSE');
select dbms_stats.get_param('ESTIMATE_BLOCK') from dual;
call dbms_stats.set_global_prefs('ESTIMATE_BLOCK', null);
select dbms_stats.get_param('ESTIMATE_BLOCK') from dual;

call dbms_stats.set_table_prefs('TEST', 'T1', 'degree', '3');
select dbms_stats.get_prefs('degree', 'TEST', 'T1') from dual;

call dbms_stats.set_table_prefs('TEST', 'T1', 'degree', NULL);
select dbms_stats.get_prefs('degree', 'TEST', 'T1') from dual;

call dbms_stats.set_table_prefs('TEST', 'T1', 'ESTIMATE_PERCENT', '30');
select dbms_stats.get_prefs('ESTIMATE_PERCENT', 'TEST', 'T1') from dual;

call dbms_stats.set_table_prefs('TEST', 'T1', 'GRANULARITY', 'global');
select dbms_stats.get_prefs('GRANULARITY', 'TEST', 'T1') from dual;

call dbms_stats.set_table_prefs('TEST', 'T1', 'method_OPT', 'FOR ALL COLUMNS SIZE 10');
select dbms_stats.get_prefs('method_OPT', 'TEST', 'T1') from dual;

call dbms_stats.set_table_prefs('TEST', 'T1', 'method_OPT', NULL);
select dbms_stats.get_prefs('method_OPT', 'TEST', 'T1') from dual;

call dbms_stats.set_schema_prefs('TEST', 'degree', '4');
select dbms_stats.get_prefs('degree', 'TEST', 'T1') from dual;
select dbms_stats.get_prefs('degree', 'TEST', 'T_PART') from dual;
select dbms_stats.get_prefs('degree', 'TEST', 'T_SUBPART') from dual;

call dbms_stats.set_schema_prefs('TEST', 'ESTIMATE_PERCENT', '60');
select dbms_stats.get_prefs('ESTIMATE_PERCENT', 'TEST', 'T1') from dual;
select dbms_stats.get_prefs('ESTIMATE_PERCENT', 'TEST', 'T_PART') from dual;
select dbms_stats.get_prefs('ESTIMATE_PERCENT', 'TEST', 'T_SUBPART') from dual;

call dbms_stats.set_schema_prefs('TEST', 'method_OPT', 'FOR ALL COLUMNS size 100');
select dbms_stats.get_prefs('method_OPT', 'TEST', 'T1') from dual;
select dbms_stats.get_prefs('method_OPT', 'TEST', 'T_PART') from dual;
select dbms_stats.get_prefs('method_OPT', 'TEST', 'T_SUBPART') from dual;


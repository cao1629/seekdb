DROP TABLE IF EXISTS fts_changed_part_key;
CREATE TABLE fts_changed_part_key(
  c1 bigint(20) NOT NULL AUTO_INCREMENT,
  c2 bigint(20) NOT NULL,
  c3 varchar(5000) DEFAULT NULL,
  PRIMARY KEY (c1, c2),
  FULLTEXT KEY ctx (c3)
) partition by key(c2)
 (partition p0,
  partition p1,
  partition p2,
  partition p3,
  partition p4,
  partition p5,
  partition p6,
  partition p7,
  partition p8,
  partition p9,
  partition p10,
  partition p11,
  partition p12,
  partition p13,
  partition p14,
  partition p15,
  partition p16,
  partition p17,
  partition p18);


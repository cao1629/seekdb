CREATE TABLE fts_parser_name_test (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(200),
    content TEXT,
    FULLTEXT INDEX ctx(title, content)
);

SHOW CREATE TABLE fts_parser_name_test;
Table	Create Table
fts_parser_name_test	CREATE TABLE `fts_parser_name_test` (
  `id` int(10) unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(200) DEFAULT NULL,
  `content` text DEFAULT NULL,
  PRIMARY KEY (`id`),
  FULLTEXT KEY `ctx` (`title`, `content`) WITH PARSER space PARSER_PROPERTIES=(min_token_size=3,max_token_size=84) BLOCK_SIZE 16384
) ORGANIZATION INDEX AUTO_INCREMENT = 1 DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0

DROP TABLE fts_parser_name_test;

CREATE TABLE fts_parser_name_test (
    title VARCHAR(200),
    content TEXT,
    FULLTEXT INDEX ctx(title, content)
);
DROP TABLE fts_parser_name_test;
create table fts_parser_name_test(seq_id int PRIMARY KEY, detail varchar(4096)) partition by hash(seq_id) partitions 2;
CREATE FULLTEXT INDEX fts_parser_name_test_index on fts_parser_name_test(detail);


DROP TABLE fts_parser_name_test;

========= for some charset =========
=== utf8 for tokenize result ===
select tokenize("abc英文空格 中文分号；英文分号;全角空格　全角逗号，等", 'space');
+----------------------------------------------------------------------------------------------------+
| tokenize("abc英文空格 中文分号；英文分号;全角空格　全角逗号，等", 'space')                         |
+----------------------------------------------------------------------------------------------------+
| ["全角逗号", "英文分号", "中文分号", "abc英文空格", "全角空格"]                                    |
+----------------------------------------------------------------------------------------------------+

drop table if exists t1;
create table t1(trailing_space VARCHAR(256), fulltext index ft1(trailing_space) with parser space) DEFAULT CHARSET = utf8mb4;

insert into t1 values("abc英文空格 中文分号；英文分号;全角空格　全角逗号，等");

select * from t1 where match(trailing_space) against ('abc英文空格' IN BOOLEAN MODE);
+-------------------------------------------------------------------------------+
| trailing_space                                                                |
+-------------------------------------------------------------------------------+
| abc英文空格 中文分号；英文分号;全角空格　全角逗号，等                         |
+-------------------------------------------------------------------------------+
select * from t1 where match(trailing_space) against ('中文分号' IN BOOLEAN MODE);
+-------------------------------------------------------------------------------+
| trailing_space                                                                |
+-------------------------------------------------------------------------------+
| abc英文空格 中文分号；英文分号;全角空格　全角逗号，等                         |
+-------------------------------------------------------------------------------+
select * from t1 where match(trailing_space) against ('英文分号' IN BOOLEAN MODE);
+-------------------------------------------------------------------------------+
| trailing_space                                                                |
+-------------------------------------------------------------------------------+
| abc英文空格 中文分号；英文分号;全角空格　全角逗号，等                         |
+-------------------------------------------------------------------------------+
select * from t1 where match(trailing_space) against ('全角空格' IN BOOLEAN MODE);
+-------------------------------------------------------------------------------+
| trailing_space                                                                |
+-------------------------------------------------------------------------------+
| abc英文空格 中文分号；英文分号;全角空格　全角逗号，等                         |
+-------------------------------------------------------------------------------+
select * from t1 where match(trailing_space) against ('全角逗号' IN BOOLEAN MODE);
+-------------------------------------------------------------------------------+
| trailing_space                                                                |
+-------------------------------------------------------------------------------+
| abc英文空格 中文分号；英文分号;全角空格　全角逗号，等                         |
+-------------------------------------------------------------------------------+

select tokenize("abc英文空格 中文分号；英文分号;全角空格　全角逗号，等", 'ngram');
+--------------------------------------------------------------------------------------------------------------------------+
| tokenize("abc英文空格 中文分号；英文分号;全角空格　全角逗号，等", 'ngram')                                               |
+--------------------------------------------------------------------------------------------------------------------------+
| ["ab", "文空", "空格", "文分", "c英", "分号", "角逗", "角空", "全角", "中文", "bc", "逗号", "英文"]                      |
+--------------------------------------------------------------------------------------------------------------------------+


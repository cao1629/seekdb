DROP TABLE IF EXISTS fts_czt_coupon_main_body;
######## Create Table With Multivalue and Fulltext Index  #########
CREATE TABLE fts_czt_coupon_main_body (
    coupon_body_id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '优惠券主体自增id',
    coupon_name VARCHAR(60)  NOT NULL DEFAULT '' COMMENT '优惠券名字',
    extra_contains json NOT NULL COMMENT '可用门店ID',
    PRIMARY KEY (coupon_body_id) ,
    KEY contain_store_ids_index ((CAST(json_extract(extra_contains,'$.contain_store_ids') AS UNSIGNED array))),
    FULLTEXT KEY coupon_name_index (coupon_name) WITH PARSER ngram
) AUTO_INCREMENT=1265 COMMENT='优惠券主体数据表';
INSERT INTO fts_czt_coupon_main_body (coupon_name, extra_contains) VALUES
('优惠券A', '{"contain_store_ids": [1000010001, 1000010002, 1000010003]}'),
('优惠券B', '{"contain_store_ids": [2000010001, 2000010002, 2000010003]}');
SELECT * FROM fts_czt_coupon_main_body order by coupon_body_id;
+----------------+-------------+-------------------------------------------------------------+
| coupon_body_id | coupon_name | extra_contains                                              |
+----------------+-------------+-------------------------------------------------------------+
|           1265 | 优惠券A     | {"contain_store_ids": [1000010001, 1000010002, 1000010003]} |
|           1266 | 优惠券B     | {"contain_store_ids": [2000010001, 2000010002, 2000010003]} |
+----------------+-------------+-------------------------------------------------------------+
SELECT *, MATCH(coupon_name) AGAINST("优惠券B") FROM fts_czt_coupon_main_body WHERE MATCH(coupon_name) AGAINST("优惠券B");
+----------------+-------------+-------------------------------------------------------------+------------------------------------------+
| coupon_body_id | coupon_name | extra_contains                                              | MATCH(coupon_name) AGAINST("优惠券B")    |
+----------------+-------------+-------------------------------------------------------------+------------------------------------------+
|           1266 | 优惠券B     | {"contain_store_ids": [2000010001, 2000010002, 2000010003]} |                        1.050955414012739 |
|           1265 | 优惠券A     | {"contain_store_ids": [1000010001, 1000010002, 1000010003]} |                       0.7006369426751594 |
+----------------+-------------+-------------------------------------------------------------+------------------------------------------+
SELECT *, MATCH(coupon_name) AGAINST("优惠券B") FROM fts_czt_coupon_main_body WHERE MATCH(coupon_name) AGAINST("优惠券B") limit 1;
+----------------+-------------+-------------------------------------------------------------+------------------------------------------+
| coupon_body_id | coupon_name | extra_contains                                              | MATCH(coupon_name) AGAINST("优惠券B")    |
+----------------+-------------+-------------------------------------------------------------+------------------------------------------+
|           1266 | 优惠券B     | {"contain_store_ids": [2000010001, 2000010002, 2000010003]} |                        1.050955414012739 |
+----------------+-------------+-------------------------------------------------------------+------------------------------------------+
DROP TABLE fts_czt_coupon_main_body;

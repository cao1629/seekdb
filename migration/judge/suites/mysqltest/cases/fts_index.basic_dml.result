INSERT INTO t1 values(1, '');
INSERT INTO t1 values(2, 'is is');
INSERT INTO t1 values(3, ' ');

UPDATE t1 SET b = 'is' WHERE a = 1;
UPDATE t1 SET b = ' ' WHERE a = 2;
UPDATE t1 SET b = '' WHERE a = 3;
SELECT * FROM t1;
+------+------+
| a    | b    |
+------+------+
|    1 | is   |
|    2 |      |
|    3 |      |
+------+------+


select id, round(match(title, body) against('wordlen2 ab wordlen3 abc wordlen4 abcd wordlen78 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz wordlen83 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz12345 wordlen84 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz123456 wordlen85 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567'), 6) as minmax from fts_min_max_word_articles where match(title, body) against('wordlen2 ab wordlen3 abc wordlen4 abcd wordlen78 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz wordlen83 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz12345 wordlen84 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz123456 wordlen85 abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567') order by id;
+----+----------+
| id | minmax   |
+----+----------+
|  1 | 2.320821 |
|  2 | 4.359380 |
|  3 | 4.359380 |
|  4 | 4.359380 |
|  5 | 4.359380 |
|  6 | 4.359380 |
|  7 | 2.320821 |
+----+----------+
select * from fts_min_max_word_articles where match(title, body) against("ab");
+----+-------+------+
| id | title | body |
+----+-------+------+
+----+-------+------+
select * from fts_min_max_word_articles where match(title, body) against("abc");
+----+----------+------+
| id | title    | body |
+----+----------+------+
|  2 | wordlen3 | abc  |
+----+----------+------+
select * from fts_min_max_word_articles where match(title, body) against("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz123456");
+----+-----------+--------------------------------------------------------------------------------------+
| id | title     | body                                                                                 |
+----+-----------+--------------------------------------------------------------------------------------+
|  6 | wordlen84 | abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz123456 |
+----+-----------+--------------------------------------------------------------------------------------+
select * from fts_min_max_word_articles where match(title, body) against("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567");
+----+-------+------+
| id | title | body |
+----+-------+------+
+----+-------+------+
drop table fts_min_max_word_articles;
################# complex dml operation ##################
DROP TABLE IF EXISTS fts;
DROP TABLE IF EXISTS normal;
DROP VIEW IF EXISTS fts_view;
CREATE TABLE fts (a int PRIMARY KEY, b text, FULLTEXT INDEX(b));
CREATE TABLE normal (a int PRIMARY KEY, b text);
CREATE VIEW fts_view as select * from fts;
set ob_enable_index_direct_select = 'ON';
INSERT INTO fts values (1, 'aaaa'), (2, 'bbbb');
INSERT INTO normal values (1, 'aaaa'), (2, 'bbbb');
result_format: 4
insert into fts values (1, 'aaaa') ON DUPLICATE KEY UPDATE b = 'aaaa';
insert into normal values (1, 'aaaa') ON DUPLICATE KEY UPDATE b = 'aaaa';
select a, b, round(match(b) against('aaaa'), 6) as cdml1 from fts where match(b) against('aaaa') order by a;
+---+------+----------+
| a | b    | cdml1    |
+---+------+----------+
| 1 | aaaa | 0.395683 |
+---+------+----------+
select a, b, round(match(b) against('bbbb'), 6) as cdml1 from fts where match(b) against('bbbb') order by a;
+---+------+----------+
| a | b    | cdml1    |
+---+------+----------+
| 2 | bbbb | 0.395683 |
+---+------+----------+
select a, b, round(match(b) against('cccc'), 6) as cdml1 from fts where match(b) against('cccc') order by a;
+---+------+-------+
| a | b    | cdml1 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('dddd'), 6) as cdml1 from fts where match(b) against('dddd') order by a;
+---+------+-------+
| a | b    | cdml1 |
+---+------+-------+
+---+------+-------+

replace into fts (a, b) values (1, 'aaaa');
replace into normal (a, b) values (1, 'aaaa');
select a, b, round(match(b) against('aaaa'), 6) as cdml2 from fts where match(b) against('aaaa') order by a;
+---+------+----------+
| a | b    | cdml2    |
+---+------+----------+
| 1 | aaaa | 0.395683 |
+---+------+----------+
select a, b, round(match(b) against('bbbb'), 6) as cdml2 from fts where match(b) against('bbbb') order by a;
+---+------+----------+
| a | b    | cdml2    |
+---+------+----------+
| 2 | bbbb | 0.395683 |
+---+------+----------+
select a, b, round(match(b) against('cccc'), 6) as cdml2 from fts where match(b) against('cccc') order by a;
+---+------+-------+
| a | b    | cdml2 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('dddd'), 6) as cdml2 from fts where match(b) against('dddd') order by a;
+---+------+-------+
| a | b    | cdml2 |
+---+------+-------+
+---+------+-------+

insert into fts_view values (3, 'cccc'), (4, 'dddd');
insert into normal (a, b) values (3, 'aaaa');
select * from fts_view;
+---+------+
| a | b    |
+---+------+
| 1 | aaaa |
| 2 | bbbb |
| 3 | cccc |
| 4 | dddd |
+---+------+
select * from normal;
+---+------+
| a | b    |
+---+------+
| 1 | aaaa |
| 2 | bbbb |
| 3 | aaaa |
+---+------+
select a, b, round(match(b) against('aaaa'), 6) as cdml3 from fts where match(b) against('aaaa') order by a;
+---+------+----------+
| a | b    | cdml3    |
+---+------+----------+
| 1 | aaaa | 1.341047 |
+---+------+----------+
select a, b, round(match(b) against('bbbb'), 6) as cdml3 from fts where match(b) against('bbbb') order by a;
+---+------+----------+
| a | b    | cdml3    |
+---+------+----------+
| 2 | bbbb | 1.341047 |
+---+------+----------+
select a, b, round(match(b) against('cccc'), 6) as cdml3 from fts where match(b) against('cccc') order by a;
+---+------+----------+
| a | b    | cdml3    |
+---+------+----------+
| 3 | cccc | 1.341047 |
+---+------+----------+
select a, b, round(match(b) against('dddd'), 6) as cdml3 from fts where match(b) against('dddd') order by a;
+---+------+----------+
| a | b    | cdml3    |
+---+------+----------+
| 4 | dddd | 1.341047 |
+---+------+----------+

update fts join normal on fts.a = normal.a set fts.b = 'dddd', normal.b = 'eeee';
select * from fts_view;
+---+------+
| a | b    |
+---+------+
| 1 | dddd |
| 2 | dddd |
| 3 | dddd |
| 4 | dddd |
+---+------+
select * from normal;
+---+------+
| a | b    |
+---+------+
| 1 | eeee |
| 2 | eeee |
| 3 | eeee |
+---+------+
select a, b, round(match(b) against('aaaa'), 6) as cdml4 from fts where match(b) against('aaaa') order by a;
+---+------+-------+
| a | b    | cdml4 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('bbbb'), 6) as cdml4 from fts where match(b) against('bbbb') order by a;
+---+------+-------+
| a | b    | cdml4 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('cccc'), 6) as cdml4 from fts where match(b) against('cccc') order by a;
+---+------+-------+
| a | b    | cdml4 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('dddd'), 6) as cdml4 from fts where match(b) against('dddd') order by a;
+---+------+----------+
| a | b    | cdml4    |
+---+------+----------+
| 1 | dddd | 0.395683 |
| 2 | dddd | 0.395683 |
| 3 | dddd | 0.395683 |
| 4 | dddd | 0.395683 |
+---+------+----------+

update fts join normal on fts.a = normal.a set fts.b = 'dddd';
update fts join normal on fts.a = normal.a set normal.b = fts.b;
select * from normal;
+---+------+
| a | b    |
+---+------+
| 1 | dddd |
| 2 | dddd |
| 3 | dddd |
+---+------+
select * from fts;
+---+------+
| a | b    |
+---+------+
| 1 | dddd |
| 2 | dddd |
| 3 | dddd |
| 4 | dddd |
+---+------+

update fts_view join normal on fts_view.a = normal.a set fts_view.b = 'dddd', normal.b = 'eeee';
update fts_view set b = 'dddd';
select * from fts;
+---+------+
| a | b    |
+---+------+
| 1 | dddd |
| 2 | dddd |
| 3 | dddd |
| 4 | dddd |
+---+------+
select * from fts_view;
+---+------+
| a | b    |
+---+------+
| 1 | dddd |
| 2 | dddd |
| 3 | dddd |
| 4 | dddd |
+---+------+
select a, b, round(match(b) against('aaaa'), 6) as cdml5 from fts where match(b) against('aaaa') order by a;
+---+------+-------+
| a | b    | cdml5 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('bbbb'), 6) as cdml5 from fts where match(b) against('bbbb') order by a;
+---+------+-------+
| a | b    | cdml5 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('cccc'), 6) as cdml5 from fts where match(b) against('cccc') order by a;
+---+------+-------+
| a | b    | cdml5 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('dddd'), 6) as cdml5 from fts where match(b) against('dddd') order by a;
+---+------+----------+
| a | b    | cdml5    |
+---+------+----------+
| 1 | dddd | 0.395683 |
| 2 | dddd | 0.395683 |
| 3 | dddd | 0.395683 |
| 4 | dddd | 0.395683 |
+---+------+----------+

delete fts, normal from fts join normal on fts.a = normal.a;
delete fts from fts join normal on fts.a = normal.a;
delete fts from fts join normal on fts.a = normal.a;

delete normal from fts_view join normal on fts_view.a = normal.a and 1=0;
delete from fts_view where b = 'dddd';
select a, b, round(match(b) against('aaaa'), 6) as cdml6 from fts where match(b) against('aaaa') order by a;
+---+------+-------+
| a | b    | cdml6 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('bbbb'), 6) as cdml6 from fts where match(b) against('bbbb') order by a;
+---+------+-------+
| a | b    | cdml6 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('cccc'), 6) as cdml6 from fts where match(b) against('cccc') order by a;
+---+------+-------+
| a | b    | cdml6 |
+---+------+-------+
+---+------+-------+
select a, b, round(match(b) against('dddd'), 6) as cdml6 from fts where match(b) against('dddd') order by a;
+---+------+-------+
| a | b    | cdml6 |
+---+------+-------+
+---+------+-------+

drop table fts;
drop table normal;


--echo ############## Drop Multiple Fulltext Index ##############
--echo ======================== create ==========================
CREATE TABLE drop_index_articles (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(200),
    content TEXT,
    FULLTEXT INDEX ctx(title, content),
    FULLTEXT INDEX ctx_t(title),
    FULLTEXT INDEX ctx_c(content)
);


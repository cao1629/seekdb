connect(sys_conn, $OBMYSQL_MS0, root@sys,,oceanbase, $OBMYSQL_PORT);
connection sys_conn;

--result_format 3

# [judge] removed: alter system set _enable_add_fulltext_index_to_existing_table = true; sleep 2;

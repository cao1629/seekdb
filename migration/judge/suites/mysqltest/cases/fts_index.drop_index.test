# [judge] ALTER TABLE ... ADD FULLTEXT INDEX works without it).

--enable_query_log
--disable_warnings
CREATE DATABASE IF NOT EXISTS drop_index_test;
--enable_warnings
USE drop_index_test;

--disable_warnings
DROP TABLE IF EXISTS drop_index_articles;
--enable_warnings

--echo ############### Drop Empty Fulltext Index ################
--echo ======================== create ==========================
CREATE TABLE drop_index_articles (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(200),
    content TEXT,
    FULLTEXT INDEX ctx(title, content)
);

# [judge] removed: let $data_table_id from oceanbase.__all_table (Tier B).

# [judge] was: count(*) of hidden aux index tables per index_type 11/12/13/14 in oceanbase.__all_table and the
# [judge] hidden FTS columns (doc_id/word_segment/word_count/doc_length, with column_id) in oceanbase.__all_column
# [judge] (Tier B). Public equivalents: SHOW INDEX (which fulltext indexes exist) and a MATCH ... AGAINST per
# [judge] fulltext column list of the table: it returns rows while that index exists and fails with
# [judge] ER_FT_MATCHING_KEY_NOT_FOUND once it is dropped.
SHOW INDEX FROM drop_index_articles;
SELECT id FROM drop_index_articles WHERE MATCH(title, content) AGAINST('oceanbase') ORDER BY id;

--echo ====================== drop index =======================

DROP INDEX ctx ON drop_index_articles;

# [judge] was: hidden aux-table counts and hidden columns (Tier B); public equivalents below.
SHOW INDEX FROM drop_index_articles;
--error ER_FT_MATCHING_KEY_NOT_FOUND
SELECT id FROM drop_index_articles WHERE MATCH(title, content) AGAINST('oceanbase') ORDER BY id;

--echo ====================== add index ========================

ALTER TABLE drop_index_articles ADD FULLTEXT INDEX ctx(title, content);

# [judge] was: hidden aux-table counts and hidden columns (Tier B); public equivalents below.
SHOW INDEX FROM drop_index_articles;
SELECT id FROM drop_index_articles WHERE MATCH(title, content) AGAINST('oceanbase') ORDER BY id;

--echo ====================== drop table =======================

DROP TABLE drop_index_articles;


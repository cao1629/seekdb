--echo errno $mysql_errno
UPDATE tn SET t3 = '2024-02-29 13:44:56.5' WHERE id = 3;
--echo errno $mysql_errno
UPDATE tn SET t6 = '2024-02-29 13:44:56.5' WHERE id = 3;

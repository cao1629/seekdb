--echo errno $mysql_errno
INSERT INTO tn (id, src) VALUES (9, 'CURDATE()');
--echo errno $mysql_errno
UPDATE tn SET s0 = CURDATE(), s3 = CURDATE(), s6 = CURDATE() WHERE id = 9;
--echo errno $mysql_errno
UPDATE tn SET t0 = CURDATE(), t3 = CURDATE(), t6 = CURDATE() WHERE id = 9;
--echo errno $mysql_errno
UPDATE tn SET dd = CURDATE() WHERE id = 9;
--echo errno $mysql_errno
INSERT INTO tn (id, src) VALUES (10, 'DATE_ADD(NOW(), INTERVAL -1 MICROSECOND)');
--echo errno $mysql_errno
UPDATE tn SET s0 = DATE_ADD(NOW(), INTERVAL -1 MICROSECOND), s3 = DATE_ADD(NOW(), INTERVAL -1 MICROSECOND), s6 = DATE_ADD(NOW(), INTERVAL -1 MICROSECOND) WHERE id = 10;
--echo errno $mysql_errno
UPDATE tn SET t0 = DATE_ADD(NOW(), INTERVAL -1 MICROSECOND), t3 = DATE_ADD(NOW(), INTERVAL -1 MICROSECOND), t6 = DATE_ADD(NOW(), INTERVAL -1 MICROSECOND) WHERE id = 10;

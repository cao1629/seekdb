INSERT INTO tn (id, src) VALUES (7, 'UTC_TIMESTAMP(6)');
--echo errno $mysql_errno
UPDATE tn SET s0 = UTC_TIMESTAMP(6), s3 = UTC_TIMESTAMP(6), s6 = UTC_TIMESTAMP(6) WHERE id = 7;

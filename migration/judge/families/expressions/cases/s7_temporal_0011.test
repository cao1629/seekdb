--echo errno $mysql_errno
UPDATE tn SET s0 = LOCALTIMESTAMP(4), s3 = LOCALTIMESTAMP(4), s6 = LOCALTIMESTAMP(4) WHERE id = 6;
--echo errno $mysql_errno
UPDATE tn SET t0 = LOCALTIMESTAMP(4), t3 = LOCALTIMESTAMP(4), t6 = LOCALTIMESTAMP(4) WHERE id = 6;
--echo errno $mysql_errno
UPDATE tn SET dd = LOCALTIMESTAMP(4) WHERE id = 6;

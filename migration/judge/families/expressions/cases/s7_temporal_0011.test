UPDATE tn SET s0 = NOW(6), s3 = NOW(6), s6 = NOW(6) WHERE id = 4;
--echo errno $mysql_errno
UPDATE tn SET t0 = NOW(6), t3 = NOW(6), t6 = NOW(6) WHERE id = 4;
--echo errno $mysql_errno
UPDATE tn SET dd = NOW(6) WHERE id = 4;
--echo errno $mysql_errno

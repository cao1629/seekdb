--echo errno $mysql_errno
UPDATE tn SET s0 = DATE_ADD(NOW(6), INTERVAL 500000 MICROSECOND), s3 = DATE_ADD(NOW(6), INTERVAL 500000 MICROSECOND), s6 = DATE_ADD(NOW(6), INTERVAL 500000 MICROSECOND) WHERE id = 11;
--echo errno $mysql_errno
UPDATE tn SET t0 = DATE_ADD(NOW(6), INTERVAL 500000 MICROSECOND), t3 = DATE_ADD(NOW(6), INTERVAL 500000 MICROSECOND), t6 = DATE_ADD(NOW(6), INTERVAL 500000 MICROSECOND) WHERE id = 11;
--echo errno $mysql_errno
UPDATE tn SET dd = DATE_ADD(NOW(6), INTERVAL 500000 MICROSECOND) WHERE id = 11;
--echo errno $mysql_errno
INSERT INTO tn (id, src) VALUES (12, 'FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6)))');
--echo errno $mysql_errno
UPDATE tn SET s0 = FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6))), s3 = FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6))), s6 = FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6))) WHERE id = 12;
--echo errno $mysql_errno
UPDATE tn SET t0 = FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6))), t3 = FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6))), t6 = FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6))) WHERE id = 12;
--echo errno $mysql_errno
UPDATE tn SET dd = FROM_UNIXTIME(UNIX_TIMESTAMP(NOW(6))) WHERE id = 12;
--echo errno $mysql_errno
SELECT id, src, s0, s3, s6, t0, t3, t6, dd FROM tn ORDER BY id;
--echo errno $mysql_errno
DROP TABLE tn;
--echo errno $mysql_errno

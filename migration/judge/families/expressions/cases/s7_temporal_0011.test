--echo errno $mysql_errno
UPDATE tn SET s0 = CURRENT_TIMESTAMP, s3 = CURRENT_TIMESTAMP, s6 = CURRENT_TIMESTAMP WHERE id = 5;
--echo errno $mysql_errno
UPDATE tn SET t0 = CURRENT_TIMESTAMP, t3 = CURRENT_TIMESTAMP, t6 = CURRENT_TIMESTAMP WHERE id = 5;

+def recorded_failure_lines(manifest, case_name):
+    outcomes = manifest.get("outcomes")
+    if not isinstance(outcomes, dict) or not isinstance(outcomes.get(case_name), dict):
+        return None
+    lines = outcomes[case_name].get("failure_lines")
+    if not isinstance(lines, list) or not all(isinstance(line, str) for line in lines):
+        return None
+    return lines
+
+
+def load_known_failures(path):
+    try:
+        data = path.read_bytes()
+        text = data.decode("utf-8")
+    except (OSError, UnicodeDecodeError) as exc:
+        raise RunnerError("cannot read known failure list {}: {}".format(path, exc))
+    names = []
+    for raw_line in text.split("\n"):
+        name = raw_line.split("#", 1)[0].strip()
+        if name:
+            names.append(name)
+    if not names:
+        raise RunnerError("known failure list {} names no cases".format(path))
+    duplicates = sorted(name for name, count in Counter(names).items() if count > 1)
+    if duplicates:
+        raise RunnerError(
+            "duplicate cases in known failure list {}: {}".format(
+                path, ", ".join(duplicates)
+            )
+        )
+    return {
+        "list": str(path),
+        "list_sha256": hashlib.sha256(data).hexdigest(),
+        "cases": names,
+    }
+
+
+def judge_known_failure(entry, left_manifest, right_manifest):
+    case_name = entry["case"]
+    lines = {
+        "left": recorded_failure_lines(left_manifest, case_name),
+        "right": recorded_failure_lines(right_manifest, case_name),
+    }
+    result = {"accepted": False, "failure_lines": lines}
+    if entry["status"] != "missing":
+        result["reason"] = "recorded on both sides"
+    elif len(entry["missing_from"]) != 2:
+        result["reason"] = "failed on the {} side only".format(
+            entry["missing_from"][0]
+        )
+    elif not entry.get("failed_alike"):
+        result["reason"] = (
+            "the two failures differ in their exit codes or partial output, or "
+            "a side left no partial output"
+        )
+    elif not lines["left"] or not lines["right"]:
+        result["reason"] = "a side recorded no mysqltest failure lines"
+    elif lines["left"] != lines["right"]:
+        result["reason"] = "the mysqltest failure lines differ"
+    else:
+        result["accepted"] = True
+    return result
+
+
+def apply_known_failures(known_failures, results, left_manifest, right_manifest):
+    listed = set(known_failures["cases"])
+    report = {
+        "list": known_failures["list"],
+        "list_sha256": known_failures["list_sha256"],
+        "listed_cases": len(known_failures["cases"]),
+        "accepted": [],
+        "not_accepted": {},
+        "not_in_recordings": sorted(
+            listed - set(entry["case"] for entry in results)
+        ),
+    }
+    for entry in results:
+        if entry["case"] not in listed:
+            continue
+        entry["known_failure"] = judge_known_failure(
+            entry, left_manifest, right_manifest
+        )
+        if entry["known_failure"]["accepted"]:
+            entry["verdict"] = "failed_alike"
+            report["accepted"].append(entry["case"])
+        else:
+            report["not_accepted"][entry["case"]] = entry["known_failure"]["reason"]
+    return report
+

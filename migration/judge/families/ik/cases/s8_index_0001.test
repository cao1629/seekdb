--disable_abort_on_error
--enable_warnings
--echo # s8_index 1
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci, ob_enable_plan_cache = 0, ob_query_timeout = 600000000, ob_trx_timeout = 600000000;
--echo errno $mysql_errno
--echo # a smart and a max_word fulltext index on one table
CREATE TABLE ik_s8_doc (id INT PRIMARY KEY, cs VARCHAR(4000), cm VARCHAR(4000), FULLTEXT INDEX fs(cs) WITH PARSER ik PARSER_PROPERTIES=(ik_mode='smart'), FULLTEXT INDEX fm(cm) WITH PARSER ik PARSER_PROPERTIES=(ik_mode='max_word'));
--echo errno $mysql_errno
SHOW CREATE TABLE ik_s8_doc;
--echo errno $mysql_errno

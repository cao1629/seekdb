--disable_abort_on_error
--enable_warnings
--echo # s3_numbers 2
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci, ob_enable_plan_cache = 0, ob_query_timeout = 600000000, ob_trx_timeout = 600000000;
--echo errno $mysql_errno
SELECT tokenize('十万八千里 九九八十一', 'ik', '[{"output": "all"}, {"additional_args": [{"ik_mode": "smart"}]}]') AS smart;
--echo errno $mysql_errno
SELECT tokenize('十万八千里 九九八十一', 'ik', '[{"output": "all"}, {"additional_args": [{"ik_mode": "max_word"}]}]') AS max_word;
--echo errno $mysql_errno
SELECT tokenize('万亿 亿万 千千万万', 'ik', '[{"output": "all"}, {"additional_args": [{"ik_mode": "smart"}]}]') AS smart;

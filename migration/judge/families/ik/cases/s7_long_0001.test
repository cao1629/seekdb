--disable_abort_on_error
--enable_warnings
--echo # s7_long 1
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci, ob_enable_plan_cache = 0, ob_query_timeout = 600000000, ob_trx_timeout = 600000000;
--echo errno $mysql_errno
--echo # long inputs, stored in a VARCHAR column
CREATE TABLE ik_s7_long (id INT PRIMARY KEY, c VARCHAR(40000));
--echo errno $mysql_errno
--echo # 1: 1000 Chinese characters, no separator: one batch
INSERT INTO ik_s7_long VALUES (1, REPEAT('人工智能技术发展迅速', 100));
--echo errno $mysql_errno
SELECT id, CHAR_LENGTH(c) AS n, tokenize(c, 'ik', '[{"output": "all"}, {"additional_args": [{"ik_mode": "smart"}]}]') AS smart FROM ik_s7_long WHERE id = 1;
--echo errno $mysql_errno
SELECT id, CHAR_LENGTH(c) AS n, tokenize(c, 'ik', '[{"output": "all"}, {"additional_args": [{"ik_mode": "max_word"}]}]') AS max_word FROM ik_s7_long WHERE id = 1;
--echo errno $mysql_errno

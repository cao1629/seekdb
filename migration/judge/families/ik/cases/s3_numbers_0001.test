--disable_abort_on_error
--enable_warnings
--echo # s3_numbers 1
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci, ob_enable_plan_cache = 0, ob_query_timeout = 600000000, ob_trx_timeout = 600000000;
--echo errno $mysql_errno
--echo # numbers and quantifiers
SELECT tokenize('一二三四五六七八九十', 'ik', '[{"output": "all"}, {"additional_args": [{"ik_mode": "smart"}]}]') AS smart;
--echo errno $mysql_errno
SELECT tokenize('一二三四五六七八九十', 'ik', '[{"output": "all"}, {"additional_args": [{"ik_mode": "max_word"}]}]') AS max_word;
--echo errno $mysql_errno
